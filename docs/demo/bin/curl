#!/usr/bin/env python3
"""A stand-in for curl, for the README's pictures: draws an avatar for whoever's picture is asked
for (a mirrored 5 by 5 pattern, in a color from their name) instead of downloading one."""
import hashlib
import struct
import sys
import zlib

args = sys.argv[1:]
target = args[args.index("-o") + 1]
url = args[-1]
seed = hashlib.sha256(url.encode()).digest()
hue = seed[0] / 255
# A soft color from the name's hash.
import colorsys
fg = tuple(int(c * 255) for c in colorsys.hls_to_rgb(hue, 0.58, 0.55))
bg = (236, 236, 240)
size, cells = 64, 5
cell = size // (cells + 1)
pad = (size - cell * cells) // 2
on = [[seed[1 + r * 3 + min(c, cells - 1 - c)] % 2 == 0 for c in range(cells)] for r in range(cells)]
rows = []
for y in range(size):
    row = bytearray([0])
    for x in range(size):
        r, c = (y - pad) // cell, (x - pad) // cell
        lit = 0 <= r < cells and 0 <= c < cells and pad <= y and pad <= x and on[r][c]
        row += bytes(fg if lit else bg)
    rows.append(bytes(row))
raw = b"".join(rows)
chunk = lambda kind, data: struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b"")
open(target, "wb").write(png)
